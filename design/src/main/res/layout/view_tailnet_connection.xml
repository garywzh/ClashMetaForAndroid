<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@{@dimen/item_header_component_size + @dimen/item_header_margin * 2}"
        android:paddingEnd="@dimen/item_tailing_margin" android:paddingBottom="@dimen/item_padding_vertical">
        <TextView android:id="@+id/state_view" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
        <TextView android:id="@+id/problem_view" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/item_text_margin"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
        <LinearLayout android:id="@+id/address_row" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/address_view" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
            <ImageButton android:id="@+id/copy_view" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:src="@drawable/ic_baseline_content_copy"
                android:contentDescription="@string/tailscale_copy_address"
                android:background="?attr/selectableItemBackgroundBorderless" app:tint="?android:attr/textColorSecondary" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/login_view"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="@dimen/item_midden_margin" android:text="@string/tailscale_login" />
    </LinearLayout>
</layout>
